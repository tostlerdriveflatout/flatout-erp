    <path class="cls-1" d="M2579.58,148.19l12.23-50.43c5.09-20.03,4.32-35.31-2.29-45.84-6.63-10.52-18.26-15.79-34.89-15.79-17.67,0-32.86,5.6-45.6,16.81-12.73,11.2-21.48,26.32-26.23,45.33l-4.07,15.28c-4.42,16.98-3.74,30.3,2.04,39.98,5.77,9.68,17.99,17.91,36.67,24.71l21.91,7.13c20.37,7.13,33.79,17.57,40.23,31.32,6.45,13.75,6.79,32.85,1.02,57.3l-3.05,11.2c-7.13,28.53-20.37,50.77-39.73,66.73-19.36,15.97-42.79,23.94-70.29,23.94s-46.87-7.89-58.07-23.69c-11.2-15.79-13.24-38.11-6.11-66.98l12.22-48.39h30.57l-12.74,50.43c-4.76,19.7-3.74,34.89,3.06,45.59,6.79,10.7,18.84,16.05,36.16,16.05,18.33,0,34.04-5.52,47.11-16.56,13.07-11.03,21.98-26.23,26.75-45.59l4.59-17.32c4.07-17.31,3.3-30.73-2.29-40.24-5.61-9.5-17.92-17.65-36.93-24.45l-23.94-8.15c-19.36-6.79-32.09-17.15-38.2-31.07-6.11-13.92-6.11-32.93,0-57.05l2.55-10.18c6.79-27.84,19.61-49.67,38.46-65.46,18.85-15.79,41.68-23.69,68.51-23.69s45.76,7.9,56.8,23.69c11.03,15.79,12.99,38.12,5.86,66.98l-11.72,48.39h-30.57Z"/>
